diff --git a/Sources/AetherEngine/Diagnostics/SourceNetworkDiagnostics.swift b/Sources/AetherEngine/Diagnostics/SourceNetworkDiagnostics.swift
index a3d34823..9e4c2462 100644
--- a/Sources/AetherEngine/Diagnostics/SourceNetworkDiagnostics.swift
+++ b/Sources/AetherEngine/Diagnostics/SourceNetworkDiagnostics.swift
@@ -14,6 +14,20 @@ public enum SourceNetworkDiagnostics {
     }
 
     @TaskLocal public static var context: Context?
+
+    /// iOS 17 back-deploy: binding a task local inside withTaskCancellationHandler aborts in
+    /// swift_task_dealloc on pre-iOS 18 runtimes when built with Xcode 26.5+, so below iOS 18 the
+    /// diagnostic context is simply not bound.
+    static func withContextCompat<R>(
+        _ value: Context?,
+        isolation: isolated (any Actor)? = #isolation,
+        operation: () async throws -> R
+    ) async rethrows -> R {
+        if #available(iOS 18, tvOS 18, macOS 15, visionOS 2, *) {
+            return try await $context.withValue(value, operation: operation)
+        }
+        return try await operation()
+    }
     private static let requestContextKey = "AetherEngine.SourceNetworkDiagnostics.context"
 
     static func request(_ request: URLRequest, context: Context?) -> URLRequest {
